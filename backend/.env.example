DATABASE_URL=sqlite:///./fx_platform.db
SESSION_EXPIRE_HOURS=12
USD_ZAR_RATE=18.50

# Fernet key used to encrypt sensitive KYC fields at rest (NFR-08a).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be kept outside the database that stores the encrypted values (NFR-04).
KYC_ENCRYPTION_KEY=replace-with-generated-fernet-key

# XRPL Testnet Integration (FR-27-29). Defaults below are UCTUSD, the
# course-provided fallback IOU (see basics.pdf: RLUSD vs our own IOU).
# Switching to the real RLUSD issuer later is a one-line change here.
XRPL_JSON_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_ISSUER_ADDRESS=rELez4x4Zqv3KYqboYVfrYPF8521Ycbxa5
XRPL_CURRENCY_CODE=5543545553440000000000000000000000000000
XRPL_TRUSTLINE_LIMIT=1000000

# A *different* Fernet key from KYC_ENCRYPTION_KEY (NFR-04/05) - encrypts
# the platform wallet's XRPL secret at rest. Generate the same way.
XRPL_KEY_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Settlement queue (FR-21/22), Redis Streams per basics.pdf's recommendation.
# `brew install redis && brew services start redis` for local dev.
REDIS_URL=redis://localhost:6379/0
